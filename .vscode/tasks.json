{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Site: abrir servidor local",
      "type": "process",
      "command": "node",
      "args": ["scripts/serve.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Site: verificar arquivos e referências",
      "type": "process",
      "command": "node",
      "args": ["scripts/verificar.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
